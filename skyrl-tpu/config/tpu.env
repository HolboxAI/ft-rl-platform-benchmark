# Google Cloud settings for the TPU replication. Sourced by gcloud/*.sh on the laptop.
# Values here are defaults; override any of them in the environment.

# gcloud is not on PATH on this laptop; this is where the SDK lives.
GCLOUD=${GCLOUD:-$HOME/Downloads/google-cloud-sdk/bin/gcloud}
PROJECT=${PROJECT:-tpu-rl-run}
# 2026-10-23: spot v6e-8 create failed for lack of capacity in us-east5-a/b, us-central1-a/b,
# us-south1-a, us-east1-d and asia-northeast1-b (us-east5-c, europe-west4-a: no capacity message).
# Default stays in the data bucket's region; override ZONE when capacity appears elsewhere.
ZONE=${ZONE:-us-east5-b}
SPOT=${SPOT:-1}                         # 1 = spot (preemptible) VMs

# Topology A (default): one trainer VM (policy on chips 0-3, ref on 4-7) + one rollout VM.
TRAINER_VM=${TRAINER_VM:-skyrl-cholec-trainer}
TRAINER_ACCEL=${TRAINER_ACCEL:-v6e-8}
ROLLOUT_VM=${ROLLOUT_VM:-skyrl-cholec-rollout}
ROLLOUT_ACCEL=${ROLLOUT_ACCEL:-v6e-1}
RUNTIME_VERSION=${RUNTIME_VERSION:-v2-alpha-tpuv6e}

# Where the two VMs keep code, models and data.
REMOTE_ROOT=${REMOTE_ROOT:-/home/\$USER}
MODEL_REMOTE=${MODEL_REMOTE:-models/cholec-sft-qwen3.5-4b}

# Data source. One of:
#   DATA_GCS=gs://<bucket>/cholec   (holds models/cholec-sft-qwen3.5-4b/ and parquet/;
#                                    filled once by gcloud/stage_data_to_gcs.sh)
#   or AWS credentials on the VMs for s3://stanford-train-data (see setup/fetch_data.sh)
DATA_GCS=${DATA_GCS:-}
