# EC2 + S3 settings for our plain-PyTorch GRPO loop (common/grpo) on Trainium, native TorchNeuron.
# Same S3-driven runner as hf-trl/trainium/ec2 (no SSH, hard time limit). Sourced by ec2/*.sh on the laptop.

AWS_PROFILE=stanford-gpu
AWS_REGION=us-east-1
S3_ROOT=s3://stanford-train-data/accel-bench/grpo-trainium

MODEL_S3_URI=s3://stanford-train-data/models/cholec-sft-qwen3.5-4b
PARQUET_S3_URI=s3://stanford-train-data/cholec/parquet

INSTANCE_NAME=grpo-cholect50-trainium
INSTANCE_TYPE=trn1.2xlarge             # 1 Trainium1 chip (2 NeuronCores, 32 GB HBM); quota allows 4
MARKET=on-demand
PRICE_PER_HOUR_USD=1.34                # us-east-1 on-demand; VERIFY
ROOT_VOLUME_GB=300
HARD_LIMIT_HOURS=3                     # smoke + 1 GRPO step; raise for the full 16-step run

AMI_ID=
DLAMI_SSM_PARAM=/aws/service/neuron/dlami/torch-neuronx-2.14.0/ubuntu-24.04/latest/image_id
IAM_INSTANCE_PROFILE=ec2-sft-trainer
SUBNET_ID=
SECURITY_GROUP_ID=
KEY_NAME=

# --- job -------------------------------------------------------------------
STAGES="env install data smoke rl1"   # add "full" for the 16-step run
TRANSFORMERS_VERSION=5.19.0            # Qwen3.5 support; same pin as the TRL leg
