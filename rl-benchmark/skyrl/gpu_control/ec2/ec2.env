# EC2 + S3 settings for the SkyRL CholecT50 GPU control run. Sourced by ec2/*.sh on the laptop.
# Launcher pattern adapted from nemoRL/ec2 (S3-driven job, no SSH, hard time limit).

AWS_PROFILE=stanford-gpu               # IAM user stanford_gpu
AWS_REGION=us-east-1
S3_ROOT=s3://stanford-train-data/accel-bench/skyrl-gpu-control   # code, control files, run outputs

MODEL_S3_URI=s3://stanford-train-data/models/cholec-sft-qwen3.5-4b
PARQUET_S3_URI=s3://stanford-train-data/cholec/parquet

# --- instance --------------------------------------------------------------
INSTANCE_NAME=skyrl-cholect50-gpu-control
# 4x A10G like the existing SkyRL run, but 384 GiB host RAM: on g5.12xlarge (192 GiB) the
# SkyRL run's final save and NeMo-RL's first step both ran the host out of RAM with CPU offload.
INSTANCE_TYPE=g5.24xlarge
MARKET=on-demand                       # on-demand | spot
PRICE_PER_HOUR_USD=8.144               # us-east-1 on-demand (as recorded by the NeMo-RL run); VERIFY
ROOT_VOLUME_GB=400                     # SkyRL uv env (torch+vLLM) + 9.9 GB model + full-model checkpoints
HARD_LIMIT_HOURS=8                     # the instance halts at this age no matter what

AMI_ID=                                # empty -> resolved from the SSM parameter below
DLAMI_SSM_PARAM=/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-ubuntu-24.04/latest/ami-id
IAM_INSTANCE_PROFILE=ec2-sft-trainer   # S3 List/Get/Put on stanford-train-data
SUBNET_ID=                             # empty -> default-VPC subnet of each zone offering INSTANCE_TYPE
SECURITY_GROUP_ID=
KEY_NAME=

# --- job -------------------------------------------------------------------
SKYRL_REF=b304652                      # commit audited in skyrl/metrics/porting_audit.json
PRESETS="tinker skyrl-grpo"            # run in this order, a fresh server for each
