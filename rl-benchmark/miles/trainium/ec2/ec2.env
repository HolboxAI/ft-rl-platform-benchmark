# EC2 + S3 settings for the Miles-on-Trainium (torch-neuronx) probe. Sourced by ec2/*.sh on the laptop.
# Same S3-driven runner as skyrl/gpu_control/ec2 (no SSH, hard time limit).

AWS_PROFILE=stanford-gpu
AWS_REGION=us-east-1
S3_ROOT=s3://stanford-train-data/accel-bench/miles-trainium

INSTANCE_NAME=miles-trainium-probe
INSTANCE_TYPE=trn1.2xlarge             # 1 Trainium1 chip (2 NeuronCores, 32 GB HBM); quota allows 4
MARKET=on-demand
PRICE_PER_HOUR_USD=1.34                # us-east-1 on-demand; VERIFY
ROOT_VOLUME_GB=200
HARD_LIMIT_HOURS=2                     # the probe needs minutes; this caps a hang at ~$2.70

AMI_ID=
# Neuron DLAMI with torch-neuronx 2.14.0 (newest at 2026-10-22), Ubuntu 24.04.
DLAMI_SSM_PARAM=/aws/service/neuron/dlami/torch-neuronx-2.14.0/ubuntu-24.04/latest/image_id
IAM_INSTANCE_PROFILE=ec2-sft-trainer
SUBNET_ID=
SECURITY_GROUP_ID=
KEY_NAME=

MILES_REF=8e99947                      # commit audited in miles/metrics/porting_audit.json
