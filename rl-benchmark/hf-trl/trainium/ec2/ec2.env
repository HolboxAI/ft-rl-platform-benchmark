# EC2 + S3 settings for TRL CholecT50 GRPO on Trainium (native TorchNeuron). Sourced by ec2/*.sh on the laptop.
# Same S3-driven runner as skyrl/gpu_control/ec2 and miles/trainium/ec2 (no SSH, hard time limit).

AWS_PROFILE=stanford-gpu
AWS_REGION=us-east-1
S3_ROOT=s3://stanford-train-data/accel-bench/hf-trl-trainium

MODEL_S3_URI=s3://stanford-train-data/models/cholec-sft-qwen3.5-4b
PARQUET_S3_URI=s3://stanford-train-data/cholec/parquet

INSTANCE_NAME=trl-cholect50-trainium
INSTANCE_TYPE=trn1.2xlarge             # 1 Trainium1 chip (2 NeuronCores, 32 GB HBM); quota allows 4.
                                       # TorchNeuron docs target Trn2/Trn3: the check stage shows whether Trn1 works.
MARKET=on-demand
PRICE_PER_HOUR_USD=1.34                # us-east-1 on-demand; VERIFY
ROOT_VOLUME_GB=300
HARD_LIMIT_HOURS=3                     # check + 1-step smoke; raise for the full 16-step run

AMI_ID=
DLAMI_SSM_PARAM=/aws/service/neuron/dlami/torch-neuronx-2.14.0/ubuntu-24.04/latest/image_id
IAM_INSTANCE_PROFILE=ec2-sft-trainer
SUBNET_ID=
SECURITY_GROUP_ID=
KEY_NAME=

# --- job -------------------------------------------------------------------
STAGES="env install data check smoke"  # add "full" for the 16-step run
TRL_VERSION=1.16.0
ACCELERATE_VERSION=1.15.0              # first version that selects torch.device("neuron") natively
TRANSFORMERS_VERSION=5.19.0            # Qwen3.5 support; same pin as Miles
